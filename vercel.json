{
  "version": 2,
  "name": "momin-jlpt-mock",
  "builds": [
    {
      "src": "api/send-score.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/send-score",
      "dest": "/api/send-score.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
